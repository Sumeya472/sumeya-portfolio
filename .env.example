# Optional Contact Form Configuration
# If you want to use Formspree for automatic background email notifications:
# 1. Sign up for free at https://formspree.io
# 2. Create a form and paste your endpoint URL below:
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# (If this variable is left empty, the portfolio automatically uses the built-in mailto: fallback that opens your visitor's default email client with your address prefilled!)
